extends Node

## Writes docs/plans/progression-walk.md from the progression walk (ADR 0139) and prints one JSON
## line (dead ends, hours per chapter). A scene, not --script: the walk reads Settings.
##   godot_console.exe --headless --path game res://tools/progression_report.tscn [-- out=<path>]
## Quits 1 when the road has dead ends. A "## Suggested fixes" section already in the file is kept.

const Walk := preload("res://scripts/crafting/progression_walk.gd")

var out_path := ""


func _ready() -> void:
	out_path = ProjectSettings.globalize_path("res://").path_join("../docs/plans/progression-walk.md").simplify_path()
	for a in OS.get_cmdline_user_args():
		if a.begins_with("out="):
			out_path = a.substr(4)
	var w = Walk.load_default()
	var res: Dictionary = w.walk()
	var keep := ""
	var old := FileAccess.get_file_as_string(out_path)
	if old.find("\n## Suggested fixes") >= 0:
		keep = old.substr(old.find("\n## Suggested fixes"))
	var f := FileAccess.open(out_path, FileAccess.WRITE)
	f.store_string(markdown(w, res) + keep)
	f.close()
	var hours := {}
	for ch in res["chapters"]:
		hours[ch["id"]] = snappedf(ch["total_s"] / 3600.0, 0.01)
	print(JSON.stringify({"progression_walk": out_path, "dead": res["dead"].size(), "off_road": res["off_road"].size(), "hours": hours}))
	get_tree().quit(1 if not res["dead"].is_empty() else 0)


static func _n(x: float) -> String:
	return ("%.0f" % x) if absf(x) >= 10.0 or is_equal_approx(x, roundf(x)) else ("%.2f" % x)


static func markdown(w, res: Dictionary) -> String:
	var L := PackedStringArray()
	L.append("# Progression walk")
	L.append("")
	L.append("Generated by `game/tools/progression_report.tscn` (ADR 0139) from the game data; do not edit by hand above")
	L.append("\"Suggested fixes\". The walk starts with empty hands and plays each chapter's main road (the final quest and")
	L.append("its deps in the chapter) in order, making every tool and station once and keeping it. Each step is gated on its")
	L.append("station, tool class and tier, heat (firepit, forge, anvil tier), fuel and firestarter, steam and power.")
	L.append("Times are play-time estimates from mining speeds per tool tier, vein sizes and the guesses in")
	L.append("`scripts/crafting/progression_walk.gd` (pickup %ds, hunt %ds, knap %ds, smith %ds ...). Waiting (fires, machines,"
		% [Walk.PICKUP_S, Walk.HUNT_S, Walk.HANDS["knap"], Walk.HANDS["smith"]])
	L.append("racks) is listed apart: a player gathers while things burn. Units: voxel items (ore, logs, rock, dirt) in")
	L.append("blocks of 64 voxels (one recipe unit), everything else in pieces.")
	L.append("")
	L.append("## Summary")
	L.append("")
	L.append("| Chapter | Age | Main-road quests | Gathering | Crafting | Vein trips | Total | Cumulative | Waiting | Dead ends |")
	L.append("|---|---|---|---|---|---|---|---|---|---|")
	var cum := 0.0
	for ch in res["chapters"]:
		cum += ch["total_s"]
		L.append("| %s | %s | %d | %s | %s | %s | **%s** | %s | %s | %d |" % [ch["id"], ch["age"], ch["road"].size(), Walk.hms(ch["gather_s"]),
			Walk.hms(ch["hands_s"]), Walk.hms(ch["trip_s"]), Walk.hms(ch["total_s"]), Walk.hms(cum), Walk.hms(ch["wait_s"]), ch["dead"].size()])
	L.append("")
	L.append("")
	L.append("Whole road, raw totals (veins: how many of the best vein the road empties):")
	L.append("")
	L.append("| Raw | Amount | Veins |")
	L.append("|---|---|---|")
	var all := {}
	for ch in res["chapters"]:
		for id in ch["raw"]:
			all[id] = float(all.get(id, 0.0)) + float(ch["raw"][id])
	var road_ids: Array = all.keys()
	road_ids.sort_custom(func(a: String, b: String) -> bool: return _group(a) + a < _group(b) + b)
	for id in road_ids:
		var veins := ""
		for v in res["veins"]:
			for s in w.sources.get(id, []):
				if s["kind"] == "mine" and s["what"] == v["material"]:
					veins = "%.1f %s" % [all[id] / float(s["per"]) / float(v["blocks"]), v["vein"]]
		L.append("| %s | %s%s | %s |" % [id, _n(all[id]), " blocks" if w.items.units(id) > 1 else "", veins])
	L.append("")
	L.append("## Dead ends")
	L.append("")
	if res["dead"].is_empty():
		L.append("None: every quest task and every step on the main road can be made or found.")
	for d in res["dead"]:
		L.append("- quest `%s` needs `%s`%s" % [d["quest"], d["need"], (", which lacks `" + "`, which lacks `".join(d["path"]) + "`") if not d["path"].is_empty() else ""])
	L.append("")
	for ch in res["chapters"]:
		L.append("## %s (%s age): %s" % [ch["title"], ch["age"], Walk.hms(ch["total_s"])])
		L.append("")
		var tl := []
		for cls in ch["tools"]:
			tl.append("%s: %s" % [cls, ch["tools"][cls] if ch["tools"][cls] != "" else "hands"])
		L.append("Tools at the start: " + ", ".join(tl) + ".")
		L.append("")
		if not ch["outliers"].is_empty():
			L.append("**Outliers:**")
			for o in ch["outliers"]:
				L.append("- " + o)
			L.append("")
		L.append("Raw totals for the main road:")
		L.append("")
		L.append("| Raw | Amount | Time | From |")
		L.append("|---|---|---|---|")
		var raw: Dictionary = ch["raw"]
		var ids: Array = raw.keys()
		ids.sort_custom(func(a: String, b: String) -> bool: return _group(a) + a < _group(b) + b)
		for id in ids:
			var src = w.how.get(id, {})
			var from: String = ("%s %s" % [src["kind"], src["what"]]) if src is Dictionary else "?"
			for s in w.sources.get(id, []):
				if w._all(s["gates"], w.have) and w._src_s(s, w.have) <= w.cost.get(id, INF) * 1.0001:
					from = "%s %s" % [s["kind"], s["what"]]
					break
			L.append("| %s | %s%s | %s | %s |" % [id, _n(raw[id]), " blocks" if w.items.units(id) > 1 else "", Walk.hms(ch["raw_s"].get(id, 0.0)), from])
		L.append("")
		if not ch["trips"].is_empty():
			for m in ch["trips"]:
				var t: Dictionary = ch["trips"][m]
				L.append("- %s: %d trip(s) to a %s vein, %s each (%.1f %s needed of %.0f a vein)" % [m, t["trips"], t["vein"], Walk.hms(t["trip_s"]),
					t["blocks"], "blocks" if m.ends_with("_ore") else "pieces", t["vein_blocks"]])
			L.append("")
		var steps: Array = ch["steps"].keys()
		steps.sort()
		var qs := []
		for q in ch["road"]:
			qs.append("%s %s" % [q, Walk.hms(ch["quest_s"][q])])
		L.append("Quests: " + ", ".join(qs) + ".")
		if not ch["loot"].is_empty():
			L.append("")
			L.append("Only found in ruin loot: " + ", ".join(ch["loot"]) + ".")
		L.append("")
		var made := []
		for m in ch["made"]:
			made.append(m)
		if not made.is_empty():
			L.append("Made once and kept: " + ", ".join(made) + ".")
			L.append("")
		var st := []
		for s in steps:
			st.append("%s x%s" % [s, _n(ch["steps"][s])])
		L.append("Steps: " + ", ".join(st) + ".")
		var slow: Array = ch["step_s"].keys()
		slow.sort_custom(func(x: String, y: String) -> bool: return ch["step_s"][x] > ch["step_s"][y])
		var sl := []
		for s in slow.slice(0, 5):
			sl.append("%s %s" % [s, Walk.hms(ch["step_s"][s])])
		L.append("")
		L.append("Most hands-on time: " + ", ".join(sl) + ".")
		L.append("")
	L.append("## Recipes for the same thing %dx or more apart" % Walk.OUTLIER)
	L.append("")
	L.append("Seconds per unit with the best tools and everything set up, waits counted at a quarter.")
	L.append("")
	L.append("| Item | Cheapest | s/unit | Dearest | s/unit | Ratio |")
	L.append("|---|---|---|---|---|---|")
	for a in res["alternatives"]:
		L.append("| %s | %s | %s | %s | %s | %.0fx |" % [a["item"], a["best"]["how"], _n(a["best"]["s"]), a["worst"]["how"], _n(a["worst"]["s"]), a["ratio"]])
	L.append("")
	L.append("## Veins")
	L.append("")
	L.append("Best vein per ore: blocks one vein holds, search walk, depth of its top under ground y %d." % Walk.GROUND_Y)
	L.append("")
	L.append("| Material | Vein | Blocks a vein | Walk | Depth |")
	L.append("|---|---|---|---|---|")
	for v in res["veins"]:
		L.append("| %s | %s | %.0f | %s | %.1f m |" % [v["material"], v["vein"], v["blocks"], Walk.hms(v["walk_s"]), v["depth_m"]])
	L.append("")
	L.append("## Recipes off the road")
	L.append("")
	L.append("Recipes nothing reachable can run (reported, not failed), with the first thing each lacks:")
	L.append("")
	var lacks := {}
	for o in res["off_road"]:
		if not lacks.has(o["lacks"]):
			lacks[o["lacks"]] = []
		lacks[o["lacks"]].append(o["recipe"])
	for k in lacks:
		L.append("- `%s`: %s" % [k, ", ".join(lacks[k])])
	L.append("")
	return "\n".join(L)


static func _group(id: String) -> String:
	for g in ["copper", "tin", "iron", "coal", "log", "clay", "stone", "gravel", "sand"]:
		if g in id:
			return g
	return "z"

{
  "_comment": "Biome list and placement rules. borders = the common neighbours within the same layer (surface-surface, cave-cave; derived vertical links surface->shallow cave are not listed, see BiomeRules.below). Source of truth for game/scripts/world/biome_rules.gd (reference + tests) and the generated prototypes/p5-sim-spike/src/biome_table.gen.h (native generator). ids 0..12 match the original WorldGen::Biome enum and must stay stable; append new biomes at the end. Regenerate the header with: godot_console.exe --headless --path game --script res://tools/biome_codegen.gd",
  "climate": {
    "_comment": "temperature = clamp(noise_weight * temp_noise + latitude_weight * clamp(-z / latitude_full_voxels, -1, 1), -1, 1) (0.5 and 0.8 so that beyond 16 km the noise can no longer undo the latitude band); north is -Z (Minecraft convention), so going north gets colder and south gets hotter. latitude_full_voxels = 32000 voxels = 16 km; 8 km north of spawn is mostly cold/taiga, 16 km is frozen. An altitude lapse cools highlands and mountains. Band edges are inclusive at the low end.",
    "north_is_negative_z": true,
    "latitude_full_voxels": 32000,
    "latitude_weight": 0.8,
    "noise_weight": 0.5,
    "lapse_start_above_sea": 70,
    "lapse_per_voxel": 0.0015,
    "jitter": 0.09,
    "temperature_bands": [
      {"name": "frozen",    "min": -1.0,  "max": -0.6},
      {"name": "cold",      "min": -0.6,  "max": -0.2},
      {"name": "temperate", "min": -0.2,  "max": 0.2},
      {"name": "warm",      "min": 0.2,   "max": 0.55},
      {"name": "hot",       "min": 0.55,  "max": 1.01}
    ],
    "humidity_bands": [
      {"name": "arid",    "min": -1.0,  "max": -0.5},
      {"name": "dry",     "min": -0.5,  "max": -0.15},
      {"name": "neutral", "min": -0.15, "max": 0.15},
      {"name": "humid",   "min": 0.15,  "max": 0.5},
      {"name": "wet",     "min": 0.5,   "max": 1.01}
    ],
    "altitude": {
      "_comment": "voxels above sea level. deep_ocean: continentalness < deep_ocean_max_continentalness; ocean: height < sea - 1; coast: 0..coast_max; lowland: ..lowland_max; highland: ..highland_max; mountain: ..tree line; alpine: tree line..snow line; snow: above snow line. Tree/snow lines (voxels) drop where cold: line = base - cold_shift * (-temperature). Constraint: tree_line_base - tree_line_cold_shift > highland_max and snow_line_base - snow_line_cold_shift > tree_line_base, so alpine never touches highlands and snow never sits below the tree line.",
      "deep_ocean_max_continentalness": -0.55,
      "coast_max": 6,
      "lowland_max": 70,
      "highland_max": 170,
      "tree_line_base": 220,
      "tree_line_cold_shift": 40,
      "snow_line_base": 330,
      "snow_line_cold_shift": 90,
      "stony_shore_min_slope": 0.6
    }
  },
  "underground": {
    "_comment": "3D biome layer. depth = surface height - y (voxels). Up to soil_depth the column keeps its surface biome; below that a cave biome is chosen from [depth band][surface humidity band] with overrides on the surface temperature band and a slow 3D cave noise (period cave_noise_period_m) for the rare deep variants. So a humid plains at the foot of a mountain has lush caves straight below it, a desert has dripstone caves, and the deep layer is the same everywhere except where the cave noise says deep dark or crystal.",
    "soil_depth": 6,
    "depth_bands": [
      {"name": "shallow", "min": 6,   "max": 60},
      {"name": "mid",     "min": 60,  "max": 160},
      {"name": "deep",    "min": 160, "max": 100000}
    ],
    "cave_noise_bands": [
      {"name": "low",  "min": -1.0, "max": -0.35},
      {"name": "mid",  "min": -0.35, "max": 0.45},
      {"name": "high", "min": 0.45, "max": 1.01}
    ],
    "cave_noise_period_m": 120
  },
  "tables": {
    "_comment": "Rows = temperature band (frozen, cold, temperate, warm, hot); columns = humidity band (arid, dry, neutral, humid, wet). Overrides are checked first, in order.",
    "lowland": {
      "frozen":    ["ice_fields", "snowy_tundra", "snowy_tundra", "snowy_taiga", "snowy_taiga"],
      "cold":      ["tundra", "tundra", "taiga", "birch_forest", "taiga"],
      "temperate": ["shrubland", "plains", "plains", "forest", "old_growth_forest"],
      "warm":      ["savanna", "savanna", "flower_meadow", "forest", "jungle"],
      "hot":       ["desert", "desert", "savanna", "jungle", "jungle"]
    },
    "lowland_overrides": [
      {"biome": "swamp", "when": {"temperature": ["temperate", "warm"], "humidity": ["wet"], "max_above_sea": 24, "min_erosion": 0.05}}
    ],
    "highland": {
      "frozen":    ["frozen_highlands", "frozen_highlands", "frozen_highlands", "frozen_highlands", "frozen_highlands"],
      "cold":      ["highlands", "highlands", "highlands", "highlands", "highlands"],
      "temperate": ["highlands", "highlands", "highlands", "highlands", "highlands"],
      "warm":      ["highlands", "highlands", "highlands", "highlands", "highlands"],
      "hot":       ["badlands", "badlands", "highlands", "highlands", "highlands"]
    },
    "cave": {
      "shallow": ["dripstone_cave", "dripstone_cave", "cave", "lush_cave", "lush_cave"],
      "mid":     ["dripstone_cave", "cave", "cave", "lush_cave", "fungal_cave"],
      "deep":    ["deep_cave", "deep_cave", "deep_cave", "deep_cave", "deep_cave"]
    },
    "cave_overrides": [
      {"biome": "frozen_cave",  "when": {"depth": ["shallow"], "temperature": ["frozen"]}},
      {"biome": "magma_cave",   "when": {"depth": ["deep"], "temperature": ["hot"]}},
      {"biome": "deep_dark",    "when": {"depth": ["deep"], "cave_noise": ["low"]}},
      {"biome": "crystal_cave", "when": {"depth": ["deep"], "cave_noise": ["high"]}},
      {"biome": "sulfur_cave",  "when": {"depth": ["mid"], "cave_noise": ["high"]}}
    ],
    "band_overrides": [
      {"biome": "volcanic", "bands": ["mountain", "alpine"], "when": {"temperature": ["warm", "hot"], "humidity": ["arid", "dry", "neutral"]}},
      {"biome": "mangrove", "bands": ["coast"], "when": {"temperature": ["warm", "hot"], "humidity": ["humid", "wet"]}}
    ],
    "mountain": "mountains",
    "alpine": "alpine",
    "snow": "snowy_peaks",
    "coast": {"default": "beach", "frozen": "snowy_beach", "steep": "stony_shore"},
    "ocean": {"default": "ocean", "frozen": "frozen_ocean"},
    "deep_ocean": "deep_ocean",
    "river": "river",
    "lake": "lake"
  },
  "biomes": [

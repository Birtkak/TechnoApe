{
 "_doc": "How running machines look while they work (ADR 0153), read by MachineFx. One entry per block entity kind; a kind with no entry keeps ParticleFx's lit-station smoke and TorchLights' fire light. when: a GDScript Expression on the entity, true while it works (default is_lit()). starved: an Expression, true while it wants to work and cannot (no power, no steam); it blinks a red lamp. Positions `at` are fractions of the footprint box (x and z across its width, y up its height) before the entity's facing turns them. emit: particle effects (data/particles.json) at per_s bursts a second while working, `if` an optional Expression. pulse: a burst when the Expression `value` rises from 0 (the steam hammer's blow). parts: boxes drawn over the model (size in voxels, colour), moved while working: spin (axis, rpm), bob (amp_m, hz), needle (value Expression mapped from range to sweep_deg about axis, follows always). shake_m: the whole model trembles by this much while working. lamp: a run lamp, steady green while working and red blinking when starved (at, default top corner). light: fire | lamp | none for TorchLights while is_lit(). Sounds are sounds.json loops with `entities`; they play while `when` holds.",
 "defaults": {"lamp_at": [0.85, 1.0, 0.15], "lamp_size": 1.5},
 "kinds": {
  "boiler": {"when": "is_lit()", "light": "fire",
   "emit": [{"effect": "machine_steam", "at": [0.5, 1.1, 0.5], "per_s": 4, "if": "pressure > 0.2"},
            {"effect": "chimney_smoke", "at": [0.2, 1.2, 0.2], "per_s": 1.5},
            {"effect": "ember", "at": [0.5, 0.15, 0.0], "per_s": 1}],
   "parts": [{"motion": "needle", "value": "pressure", "range": [0.0, 1.5], "sweep_deg": [-70, 70], "axis": "z", "at": [0.5, 0.85, -0.02], "size": [0.5, 3, 0.5], "color": "#d04020"}]},
  "turbine": {"when": "rpm > 0.0", "light": "none",
   "emit": [{"effect": "machine_steam", "at": [0.5, 1.0, 0.5], "per_s": 1.5}]},
  "compressor": {"when": "is_lit()", "starved": "not powered()", "light": "none", "shake_m": 0.01,
   "emit": [{"effect": "machine_steam", "at": [0.5, 1.0, 0.5], "per_s": 1}],
   "parts": [{"motion": "needle", "value": "air", "range": [0.0, 1.0], "sweep_deg": [-70, 70], "axis": "z", "at": [0.5, 0.7, -0.02], "size": [0.4, 2.5, 0.4], "color": "#d04020"}]},
  "steam_hammer": {"when": "powered() and has_recipe() and ready.is_empty()", "light": "none",
   "emit": [{"effect": "machine_steam", "at": [0.55, 1.0, 0.3], "per_s": 1}],
   "pulse": [{"value": "_head_down", "effect": "machine_sparks", "at": [0.5, 0.65, 0.5]},
             {"value": "_head_down", "effect": "steam_jet", "at": [0.5, 0.72, 0.5]}]},
  "steam_sieve": {"when": "powered() and loads > 0", "light": "none", "shake_m": 0.03,
   "emit": [{"effect": "machine_steam", "at": [0.8, 1.0, 0.8], "per_s": 1}]},
  "ore_crusher": {"when": "powered() and loads > 0", "light": "none", "shake_m": 0.03,
   "emit": [{"effect": "machine_steam", "at": [0.8, 1.0, 0.8], "per_s": 1}],
   "parts": [{"motion": "spin", "axis": "x", "rpm": 90, "at": [0.5, 1.0, 0.38], "size": [10, 2, 2], "color": "#3c3a40"},
             {"motion": "spin", "axis": "x", "rpm": -90, "at": [0.5, 1.0, 0.62], "size": [10, 2, 2], "color": "#3c3a40"}]},
  "blast_furnace": {"when": "is_lit()", "light": "fire",
   "emit": [{"effect": "chimney_smoke", "at": [0.5, 1.1, 0.5], "per_s": 2}, {"effect": "ember", "at": [0.5, 1.05, 0.5], "per_s": 1}]},
  "bloomery": {"when": "is_lit()", "light": "fire",
   "emit": [{"effect": "chimney_smoke", "at": [0.5, 1.05, 0.5], "per_s": 2}, {"effect": "ember", "at": [0.5, 1.0, 0.5], "per_s": 1}]},
  "forge": {"when": "is_lit()", "light": "fire",
   "emit": [{"effect": "chimney_smoke", "at": [0.5, 1.02, 0.5], "per_s": 1.5}, {"effect": "ember", "at": [0.5, 0.3, 0.5], "per_s": 1.5}]},
  "coke_oven": {"when": "is_lit()", "light": "fire",
   "emit": [{"effect": "chimney_smoke", "at": [0.5, 1.05, 0.5], "per_s": 2.5}, {"effect": "ember", "at": [0.5, 0.2, 0.0], "per_s": 0.5}]},
  "electric_furnace": {"when": "is_lit()", "starved": "not load.on and not inv.is_empty_slot(0)", "light": "none", "lamp": {},
   "emit": [{"effect": "machine_steam", "at": [0.5, 1.0, 0.5], "per_s": 0.5}]},
  "macerator": {"when": "is_lit()", "starved": "load != null and not powered() and not current().is_empty()", "light": "none", "lamp": {}, "shake_m": 0.015,
   "parts": [{"motion": "spin", "axis": "x", "rpm": 120, "at": [0.5, 1.0, 0.4], "size": [8, 1.5, 1.5], "color": "#4a4650"},
             {"motion": "spin", "axis": "x", "rpm": -120, "at": [0.5, 1.0, 0.6], "size": [8, 1.5, 1.5], "color": "#4a4650"}]},
  "lathe": {"when": "is_lit()", "starved": "load != null and not powered() and not current().is_empty()", "light": "none", "lamp": {},
   "parts": [{"motion": "spin", "axis": "x", "rpm": 240, "at": [0.5, 1.0, 0.5], "size": [8, 1.5, 1.5], "color": "#8a8a90"}]},
  "wiremill": {"when": "is_lit()", "starved": "load != null and not powered() and not current().is_empty()", "light": "none", "lamp": {},
   "parts": [{"motion": "spin", "axis": "y", "rpm": 60, "at": [0.5, 1.0, 0.5], "size": [6, 1, 1], "color": "#c07040"}]},
  "bending_press": {"when": "is_lit()", "starved": "load != null and not powered() and not current().is_empty()", "light": "none", "lamp": {},
   "parts": [{"motion": "bob", "amp_m": 0.08, "hz": 1.0, "at": [0.5, 1.05, 0.5], "size": [6, 1.5, 6], "color": "#5a5860"}]},
  "cutter": {"when": "is_lit()", "starved": "load != null and not powered() and not current().is_empty()", "light": "none", "lamp": {},
   "emit": [{"effect": "machine_sparks", "at": [0.5, 1.0, 0.5], "per_s": 3}],
   "parts": [{"motion": "spin", "axis": "z", "rpm": 300, "at": [0.5, 1.0, 0.5], "size": [5, 5, 0.5], "color": "#b8bcc4"}]},
  "electric_compressor": {"when": "is_lit()", "starved": "load != null and not powered() and not current().is_empty()", "light": "none", "lamp": {}, "shake_m": 0.01},
  "alloy_smelter": {"when": "is_lit()", "starved": "load != null and not powered() and not current().is_empty()", "light": "fire", "lamp": {},
   "emit": [{"effect": "smoke", "at": [0.5, 1.0, 0.5], "per_s": 1}]},
  "assembler": {"when": "is_lit()", "starved": "load != null and not powered() and not current().is_empty()", "light": "none", "lamp": {}},
  "extractor": {"when": "is_lit()", "starved": "load != null and not powered() and not current().is_empty()", "light": "none", "lamp": {}},
  "extruder": {"when": "is_lit()", "starved": "load != null and not powered() and not current().is_empty()", "light": "none", "lamp": {}},
  "canning_machine": {"when": "is_lit()", "starved": "load != null and not powered() and not current().is_empty()", "light": "none", "lamp": {}},
  "electrolyzer": {"when": "is_lit()", "starved": "load != null and not powered() and not current().is_empty()", "light": "none", "lamp": {},
   "emit": [{"effect": "machine_steam", "at": [0.5, 1.0, 0.5], "per_s": 0.7}]},
  "scrubber": {"when": "is_lit()", "starved": "load != null and not powered() and not current().is_empty()", "light": "none", "lamp": {}},
  "battery_box": {"when": "false", "light": "none",
   "parts": [{"motion": "needle", "value": "charge / wh", "range": [0.0, 1.0], "sweep_deg": [-70, 70], "axis": "z", "at": [0.5, 0.75, -0.02], "size": [0.4, 2.5, 0.4], "color": "#d04020"}]},
  "electric_lamp": {"when": "is_lit()", "light": "lamp"},
  "water_wheel": {"when": "drive > 0.0", "light": "none",
   "emit": [{"effect": "splash", "at": [0.5, 0.15, 0.5], "per_s": 2, "if": "drive > 0.2"}]},
  "large_water_wheel": {"when": "drive > 0.0", "light": "none",
   "emit": [{"effect": "splash", "at": [0.5, 0.15, 0.5], "per_s": 4, "if": "drive > 0.2"}]},
  "belt": {"when": "false", "light": "none"},
  "rail": {"when": "false", "light": "none"}
 }
}

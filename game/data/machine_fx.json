{
 "_doc": "How running machines look while they work (ADR 0153), read by MachineFx. One entry per block entity kind; a kind with no entry keeps ParticleFx's lit-station smoke and TorchLights' fire light. when: a GDScript Expression on the entity, true while it works (default is_lit()). starved: an Expression, true while it wants to work and cannot (no power, no steam); it blinks a red lamp. Positions `at` are fractions of the footprint box (x and z across its width, y up its height) before the entity's facing turns them. emit: particle effects (data/particles.json) at per_s bursts a second while working, `if` an optional Expression. pulse: a burst when the Expression `value` rises from 0 (the steam hammer's blow). parts: moving pieces in the model's own cell grid and palette (facing 0, the coordinates of its view_parts): `cut` [a, b] takes those cells out of the drawn model; the part is the model's cells there, or what `boxes` [[a, b, PAINT]], `drums` [{x: [x0, x1], cy, cz, r, paint, rivets: [x]}] along x and a `disc` {z, cx, cy, r, paint, teeth} draw (WorkPalette paint names); `pivot` in cells (default the part's centre). Motions while working: spin (axis, rpm), bob (axis, amp in cells, hz), swing (axis, deg, hz); needle (value Expression mapped from range to sweep_deg about axis) follows always. shake_m: the whole model trembles by this much while working. lamp: a run lamp, steady green while working, red blinking when starved, dark otherwise (at, default top corner). light: fire | lamp | none for TorchLights while is_lit(). Sounds are sounds.json loops with `entities`; they play while `when` holds.",
 "defaults": {"lamp_at": [0.85, 1.0, 0.15], "lamp_size": 1.5},
 "kinds": {
  "boiler": {"when": "is_lit()", "light": "fire",
   "emit": [{"effect": "machine_steam", "at": [0.5, 1.1, 0.5], "per_s": 4, "if": "pressure > 0.2"},
            {"effect": "chimney_smoke", "at": [0.2, 1.2, 0.2], "per_s": 1.5},
            {"effect": "ember", "at": [0.5, 0.15, 0.0], "per_s": 1}],
   "parts": [{"motion": "needle", "value": "pressure", "range": [0.0, 1.5], "sweep_deg": [-70, 70], "axis": "x",
              "boxes": [[[-1, 13, 10], [0, 15, 11], "SOOT"]], "pivot": [-0.5, 13, 10.5]}]},
  "turbine": {"when": "rpm > 0.0", "light": "none",
   "emit": [{"effect": "machine_steam", "at": [0.5, 1.0, 0.5], "per_s": 1.5}]},
  "compressor": {"when": "is_lit()", "starved": "not powered()", "light": "none", "shake_m": 0.01,
   "emit": [{"effect": "machine_steam", "at": [0.5, 1.0, 0.5], "per_s": 1}]},
  "steam_hammer": {"when": "powered() and has_recipe() and ready.is_empty()", "light": "none",
   "emit": [{"effect": "machine_steam", "at": [0.55, 1.0, 0.3], "per_s": 1}],
   "pulse": [{"value": "_head_down", "effect": "machine_sparks", "at": [0.5, 0.5, 0.5]},
             {"value": "_head_down", "effect": "steam_jet", "at": [0.95, 0.78, 0.5]}]},
  "steam_sieve": {"when": "powered() and loads > 0", "light": "none", "shake_m": 0.03,
   "emit": [{"effect": "machine_steam", "at": [0.8, 1.0, 0.8], "per_s": 1}]},
  "ore_crusher": {"when": "powered() and loads > 0", "light": "none", "shake_m": 0.03,
   "emit": [{"effect": "machine_steam", "at": [0.8, 1.0, 0.8], "per_s": 1}]},
  "blast_furnace": {"when": "is_lit()", "light": "fire",
   "emit": [{"effect": "chimney_smoke", "at": [0.5, 1.1, 0.5], "per_s": 2}, {"effect": "ember", "at": [0.5, 1.05, 0.5], "per_s": 1}]},
  "bloomery": {"when": "is_lit()", "light": "fire",
   "emit": [{"effect": "chimney_smoke", "at": [0.5, 1.05, 0.5], "per_s": 2}, {"effect": "ember", "at": [0.5, 1.0, 0.5], "per_s": 1}]},
  "forge": {"when": "is_lit()", "light": "fire",
   "emit": [{"effect": "chimney_smoke", "at": [0.5, 1.02, 0.5], "per_s": 1.5}, {"effect": "ember", "at": [0.5, 0.3, 0.5], "per_s": 1.5}]},
  "coke_oven": {"when": "is_lit()", "light": "fire",
   "emit": [{"effect": "chimney_smoke", "at": [0.5, 1.05, 0.5], "per_s": 2.5}, {"effect": "ember", "at": [0.5, 0.2, 0.0], "per_s": 0.5}]},
  "electric_furnace": {"when": "is_lit()", "starved": "not load.on and not inv.is_empty_slot(0)", "light": "none", "lamp": {},
   "emit": [{"effect": "machine_steam", "at": [0.5, 1.0, 0.5], "per_s": 0.5}]},
  "macerator": {"when": "is_lit()", "starved": "load != null and not powered() and not current().is_empty()", "light": "none", "lamp": {}, "shake_m": 0.015,
   "parts": [{"motion": "bob", "axis": "y", "amp": 0.6, "hz": 3.0, "cut": [[3, 14, 3], [13, 15, 13]]}]},
  "lathe": {"when": "is_lit()", "starved": "load != null and not powered() and not current().is_empty()", "light": "none", "lamp": {},
   "parts": [{"motion": "spin", "axis": "x", "rpm": 240, "cut": [[5, 13, 6], [12, 16, 11]],
              "drums": [{"x": [5, 12], "cy": 14.5, "cz": 8.0, "r": 1.6, "paint": "BRONZE", "rivets": [5, 11]}], "pivot": [8.5, 14.5, 8.0]}]},
  "wiremill": {"when": "is_lit()", "starved": "load != null and not powered() and not current().is_empty()", "light": "none", "lamp": {},
   "parts": [{"motion": "spin", "axis": "x", "rpm": 60, "cut": [[4, 13, 5], [12, 16, 11]],
              "drums": [{"x": [5, 11], "cy": 14.5, "cz": 8.0, "r": 1.6, "paint": "COPPER"},
                        {"x": [4, 5], "cy": 14.5, "cz": 8.0, "r": 2.4, "paint": "IRON_DARK", "rivets": [4]},
                        {"x": [11, 12], "cy": 14.5, "cz": 8.0, "r": 2.4, "paint": "IRON_DARK", "rivets": [11]}], "pivot": [8.0, 14.5, 8.0]}]},
  "bending_press": {"when": "is_lit()", "starved": "load != null and not powered() and not current().is_empty()", "light": "none", "lamp": {},
   "parts": [{"motion": "bob", "axis": "y", "amp": -1.0, "hz": 1.2, "cut": [[4, 14, 4], [12, 16, 12]]}]},
  "cutter": {"when": "is_lit()", "starved": "load != null and not powered() and not current().is_empty()", "light": "none", "lamp": {},
   "emit": [{"effect": "machine_sparks", "at": [0.5, 1.0, 0.5], "per_s": 3}],
   "parts": [{"motion": "spin", "axis": "z", "rpm": 300, "cut": [[4, 14, 7], [13, 16, 8]],
              "disc": {"z": 7, "cx": 8.0, "cy": 13.0, "r": 3.2, "paint": "STEEL", "teeth": "RIVET"}, "pivot": [8.0, 13.0, 7.5]}]},
  "electric_compressor": {"when": "is_lit()", "starved": "load != null and not powered() and not current().is_empty()", "light": "none", "lamp": {}, "shake_m": 0.01,
   "parts": [{"motion": "bob", "axis": "y", "amp": 1.0, "hz": 2.0, "cut": [[5, 13, 5], [11, 15, 11]]}]},
  "alloy_smelter": {"when": "is_lit()", "starved": "load != null and not powered() and not current().is_empty()", "light": "fire", "lamp": {},
   "emit": [{"effect": "smoke", "at": [0.5, 1.0, 0.5], "per_s": 1}]},
  "assembler": {"when": "is_lit()", "starved": "load != null and not powered() and not current().is_empty()", "light": "none", "lamp": {},
   "parts": [{"motion": "swing", "axis": "y", "deg": 35, "hz": 0.5, "cut": [[6, 14, 7], [13, 16, 9]], "pivot": [5.0, 15.0, 8.0]}]},
  "extractor": {"when": "is_lit()", "starved": "load != null and not powered() and not current().is_empty()", "light": "none", "lamp": {},
   "parts": [{"motion": "spin", "axis": "y", "rpm": 30, "cut": [[7, 14, 7], [9, 16, 9]], "pivot": [8.0, 15.0, 8.0]}]},
  "extruder": {"when": "is_lit()", "starved": "load != null and not powered() and not current().is_empty()", "light": "none", "lamp": {},
   "parts": [{"motion": "bob", "axis": "x", "amp": 1.0, "hz": 0.5, "cut": [[9, 13, 6], [14, 15, 10]]}]},
  "canning_machine": {"when": "is_lit()", "starved": "load != null and not powered() and not current().is_empty()", "light": "none", "lamp": {},
   "parts": [{"motion": "bob", "axis": "y", "amp": -1.0, "hz": 1.5, "cut": [[6, 15, 7], [10, 16, 12]]}]},
  "electrolyzer": {"when": "is_lit()", "starved": "load != null and not powered() and not current().is_empty()", "light": "none", "lamp": {},
   "emit": [{"effect": "machine_steam", "at": [0.5, 1.0, 0.5], "per_s": 0.7}]},
  "scrubber": {"when": "is_lit()", "starved": "load != null and not powered() and not current().is_empty()", "light": "none", "lamp": {}},
  "builder": {"when": "is_lit()", "starved": "has_site and not powered()", "light": "none", "lamp": {},
   "emit": [{"effect": "machine_sparks", "at": [0.5, 1.0, 0.5], "per_s": 1.5}]},
  "lift_winch": {"when": "moving()", "starved": "not arrived and not load.on", "light": "none", "lamp": {},
   "parts": [{"motion": "spin", "axis": "x", "rpm": 40,
              "drums": [{"x": [4, 12], "cy": 14.5, "cz": 8.0, "r": 1.5, "paint": "WOOD"},
                        {"x": [3, 4], "cy": 14.5, "cz": 8.0, "r": 2.2, "paint": "IRON_DARK", "rivets": [3]},
                        {"x": [12, 13], "cy": 14.5, "cz": 8.0, "r": 2.2, "paint": "IRON_DARK", "rivets": [12]}], "pivot": [8.0, 14.5, 8.0]}]},
  "drawbridge_hinge": {"when": "moving()", "starved": "not arrived and not load.on", "light": "none", "lamp": {},
   "parts": [{"motion": "spin", "axis": "x", "rpm": 15,
              "drums": [{"x": [3, 13], "cy": 14.5, "cz": 8.0, "r": 2.0, "paint": "BRONZE", "rivets": [3, 8, 12]}], "pivot": [8.0, 14.5, 8.0]}]},
  "crane": {"when": "moving()", "starved": "not arrived and not load.on", "light": "none", "lamp": {},
   "parts": [{"motion": "spin", "axis": "y", "rpm": 10,
              "boxes": [[[4, 13, 4], [12, 14, 12], "STEEL"], [[5, 13, 5], [11, 14, 11], "IRON_DARK"], [[4, 13, 7], [12, 14, 9], "HAZARD"],
                        [[7, 14, 7], [9, 16, 9], "IRON_DARK"]], "pivot": [8.0, 13.0, 8.0]}]},
  "electric_lamp": {"when": "is_lit()", "light": "lamp"},
  "water_wheel": {"when": "drive > 0.0", "light": "none",
   "emit": [{"effect": "splash", "at": [0.5, 0.15, 0.5], "per_s": 2, "if": "drive > 0.2"}]},
  "large_water_wheel": {"when": "drive > 0.0", "light": "none",
   "emit": [{"effect": "splash", "at": [0.5, 0.15, 0.5], "per_s": 4, "if": "drive > 0.2"}]},
  "belt": {"when": "false", "light": "none"},
  "rail": {"when": "false", "light": "none"}
 }

; Engine configuration file.
config_version=5

[application]

config/name="TechnoApe"
run/main_scene="res://scenes/title.tscn"
config/features=PackedStringArray("4.7")
; play is capped at 120 fps: 500 fps on a menu or an empty view only heats the GPU. Autopilot
; runs with vsync=0 lift the cap (DebugCapture) so they measure the real frame cost
run/max_fps=120

[autoload]

Settings="*res://scripts/settings.gd"
DebugCapture="*res://scripts/debug_capture.gd"
Sound="*res://scripts/audio/game_audio.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/vsync/vsync_mode=1


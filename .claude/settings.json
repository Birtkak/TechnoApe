{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/tools/stop-check.sh\"",
            "shell": "bash",
            "timeout": 300,
            "statusMessage": "cargo test before stopping"
          }
        ]
      }
    ]
  }
}

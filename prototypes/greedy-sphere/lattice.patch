     return vec3f(c.base) + local * f32(1u << ((c.info >> 3u) & 31u));
 }
 
+// where a point of chunk c (in its cells) is drawn, from the body's centre: trilinear between the exact grid
+// points on a lattice every 8 of its cells, so a merged quad's edge, inside one lattice cell, passes through
+// its neighbours' corners (prototypes/greedy-sphere). `at` is the quad's own corner, which picks the cell.
+fn place(c: Chunk, b: Body, local: vec3f, at: vec3f) -> vec3f {
+    let s = f32(1u << ((c.info >> 3u) & 31u));
+    let l0 = floor(at / 8.0) * 8.0;
+    let t = (local - l0) / 8.0;
+    let g0 = vec3f(c.base) + l0 * s;
+    let st = 8.0 * s;
+    let face = c.info & 7u;
+    let u0 = mix(frame_at(face, b, g0.x, g0.y).up, frame_at(face, b, g0.x + st, g0.y).up, t.x);
+    let u1 = mix(frame_at(face, b, g0.x, g0.y + st).up, frame_at(face, b, g0.x + st, g0.y + st).up, t.x);
+    let r = mix(b.r0 * exp(g0.z * b.lnq), b.r0 * exp((g0.z + st) * b.lnq), t.z);
+    return mix(u0, u1, t.y) * r;
+}

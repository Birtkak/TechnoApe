#!/usr/bin/env python
# P5: builds the technosim GDExtension against godot-cpp.
#   python -m SCons platform=windows target=template_debug   (or template_release)
import os

env = SConscript(os.environ.get("GODOT_CPP_PATH", os.path.expanduser("~/Tools/godot-cpp")) + "/SConstruct")

env.Append(CPPPATH=["src/"])
if env["platform"] == "windows" and not env.get("use_mingw"):
    env.Append(CXXFLAGS=["/O2", "/std:c++17"])
else:
    # SSE4.1 (every CPU Godot 4.5+ runs on): std::floor is one instruction instead of a libm call (ADR 0135)
    env.Append(CXXFLAGS=["-O2", "-std=c++17", "-msse4.1"] + (["-g"] if ARGUMENTS.get("prof") == "1" else []))   # prof=1: line info for game/tools/gen_prof.py

sources = Glob("src/*.cpp")
library = env.SharedLibrary(
    "bin/libtechnosim{}{}".format(env["suffix"], env["SHLIBSUFFIX"]),
    source=sources,
)
Default(library)

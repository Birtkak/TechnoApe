[configuration]

entry_symbol = "technosim_library_init"
compatibility_minimum = "4.5"

[libraries]

windows.debug.x86_64 = "res://bin/libtechnosim.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://bin/libtechnosim.windows.template_release.x86_64.dll"
linux.debug.x86_64 = "res://bin/libtechnosim.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://bin/libtechnosim.linux.template_release.x86_64.so"
android.debug.arm64 = "res://bin/libtechnosim.android.template_debug.arm64.so"
android.release.arm64 = "res://bin/libtechnosim.android.template_release.arm64.so"

+// lit as the terrain is: its own sun ray (and the lamps' and the moon's) for every pixel
 @fragment
 fn fs_fx(i: FxOut) -> GOut {
     let l = light(i.rel, normalize(i.normal), (i.info >> 8u) & 3u, vec2u(i.clip.xy));
     return fx_out(i, fx_colour(i), l.l);
 }
+
+// the spike's other way: the sun's visibility once per particle (fx_vis), no lamps' or moon's rays
+@fragment
+fn fs_fx_one(i: FxOut) -> GOut {
+    let sd = normalize(g.sun_pos.xyz - i.rel);
+    return fx_out(i, fx_colour(i), g.sun_col.rgb * max(dot(normalize(i.normal), sd), 0.0) * fx_vis[i.idx]);
+}
+
+@group(1) @binding(0) var<storage, read_write> fx_vis_w: array<f32>;
+@compute @workgroup_size(64)
+fn fx_light(@builtin(global_invocation_id) id: vec3u) {
+    if (id.x >= g.opt.z) { return; }
+    let q = fxp[id.x];
+    let bi = (q.info >> 8u) & 3u;
+    let b = g.bodies[bi];
+    let rel = brot(b, (q.p - b.cam_hi) - b.cam_lo);
+    let up = brot(b, normalize(q.p));
+    var vis = left_by(bi, rel, g.sun_pos.xyz, g.sun_pos.w);
+    if (vis > 0.0) { vis *= ray(rel + up * q.size, up, normalize(g.sun_pos.xyz - rel), bi, 1e5); }
+    fx_vis_w[id.x] = vis;
+}
